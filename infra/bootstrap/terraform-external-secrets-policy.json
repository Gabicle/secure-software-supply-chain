{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateExternalSecretsRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::542489916995:role/secure-software-supply-chain-dev-external-secrets",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::542489916995:policy/SecureSupplyChainExternalSecretsRoleBoundary"
        }
      }
    },
    {
      "Sid": "ManageExternalSecretsRole",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::542489916995:role/secure-software-supply-chain-dev-external-secrets"
    },
    {
      "Sid": "PassExternalSecretsRoleToEks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::542489916995:role/secure-software-supply-chain-dev-external-secrets",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "pods.eks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManagePodIdentityAssociation",
      "Effect": "Allow",
      "Action": [
        "eks:CreatePodIdentityAssociation",
        "eks:DeletePodIdentityAssociation",
        "eks:DescribePodIdentityAssociation",
        "eks:ListPodIdentityAssociations",
        "eks:UpdatePodIdentityAssociation"
      ],
      "Resource": "*"
    }
  ]
}
