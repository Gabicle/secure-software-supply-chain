{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RdsMonitoringLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy"
      ],
      "Resource": "arn:aws:logs:eu-west-3:542489916995:log-group:RDS*"
    },
    {
      "Sid": "RdsMonitoringLogStreams",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-west-3:542489916995:log-group:RDS*:log-stream:*"
    }
  ]
}