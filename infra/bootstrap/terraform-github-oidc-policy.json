{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageGitHubOidcProvider",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider",
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint",
        "iam:TagOpenIDConnectProvider",
        "iam:UntagOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::542489916995:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "CreateGitHubActionsEcrRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::542489916995:role/SecureSupplyChainGitHubActionsEcrRole",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::542489916995:policy/SecureSupplyChainGitHubActionsEcrRoleBoundary"
        }
      }
    },
    {
      "Sid": "ManageGitHubActionsEcrRole",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::542489916995:role/SecureSupplyChainGitHubActionsEcrRole"
    }
  ]
}